# ---------------------------------------------------------------- Bannerka
# Copy to .env and adjust. All variables are optional.

APP_ENV=production
# Public port of the web container (put nginx with HTTPS in front of it, see deploy/)
WEB_PORT=8080

# Behind HTTPS set to true: the session cookie gets the Secure flag
COOKIE_SECURE=false

# Limits
MAX_CLIP_SECONDS=180          # max length of the selected fragment
MAX_BANNER_MB=50              # banner upload limit
MAX_UPLOAD_MB=1024            # video upload ("from device") limit
MAX_ACTIVE_JOBS_PER_SESSION=3 # parallel jobs per anonymous session
RATE_LIMIT_PER_MINUTE=240     # API requests per session per minute
FILE_TTL_HOURS=24             # projects/files are removed after this idle time
ASSET_TTL_HOURS=168           # banner library: since last use

# Media
MAX_SOURCE_SHORT_SIDE=1080    # downloaded fragment: short side ≤ 1080 (1080p)
PROXY_SHORT_SIDE=540          # preview proxy
RENDER_PRESET=veryfast        # x264 preset for exports
WORKER_MAX_JOBS=2             # concurrent jobs per worker process
# Optional: cookies.txt for yt-dlp (age-restricted / bot-checked videos), mounted into the containers
# YTDLP_COOKIES_FILE=/data/storage/cookies.txt

# Speech recognition (faster-whisper): tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Build the backend image without faster-whisper (smaller image, no subtitles generation)
WITH_WHISPER=1

# Development only
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./storage
# CORS_ORIGINS=["http://localhost:5173"]
